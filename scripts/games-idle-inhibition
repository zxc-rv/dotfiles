#!/usr/bin/env bash
set -euo pipefail

inhibit_active=0

check_focus() {
  local app_id
  app_id=$(niri msg -j focused-window | jq -r '.app_id // empty')
  if [[ "$app_id" == steam_app_* ]]; then
    if ((inhibit_active == 0)); then
      dms ipc call inhibit enable
      inhibit_active=1
    fi
  else
    if ((inhibit_active == 1)); then
      dms ipc call inhibit disable
      inhibit_active=0
    fi
  fi
}

niri msg -j event-stream | jq --unbuffered -r '
  if has("WindowFocusChanged") or has("WindowClosed") or has("WindowOpenedOrChanged") then "check" else empty end
' | while read -r _; do
  check_focus
done
